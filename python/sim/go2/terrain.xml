<mujoco model="go2_terrain_clean">

  <include file="go2.xml"/>

  <statistic center="0 0 0.3" extent="3"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6"
               ambient="0.3 0.3 0.3"
               specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox"
             builtin="gradient"
             rgb1="0.3 0.5 0.7"
             rgb2="0 0 0"
             width="512"
             height="3072"/>

    <!-- ✅ SINGLE CLEAN TERRAIN -->
    <hfield name="terrain"
            size="4 4 0.3 0.5"
            file="../height_field.png"/>
  </asset>

  <worldbody>

    <light pos="0 0 2.5"
           dir="0 0 -1"
           directional="true"/>

    <!-- ✅ MAIN TERRAIN (NO PLANE!) -->
    <geom type="hfield"
          hfield="terrain"
          pos="0 0 0"
          quat="1 0 0 0"
          friction="1.5 0.1 0.1"
          condim="3"/>

    <!-- ✅ Small safe obstacles (like your stairs file style) -->
    <!-- <geom pos="1.5 0 0.1"
          type="box"
          size="0.3 0.3 0.1"/>

    <geom pos="-1.0 1.0 0.08"
          type="box"
          size="0.2 0.4 0.08"/> -->

  </worldbody>

</mujoco>