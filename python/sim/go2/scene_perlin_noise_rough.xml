<mujoco model="go2 huge terrain">

    <!-- Robot -->
    <include file="go2.xml"/>

    <!-- Camera / scene statistics -->
    <statistic center="0 0 0.3" extent="25"/>

    <!-- Visual settings -->
    <visual>
        <headlight
            diffuse="0.7 0.7 0.7"
            ambient="0.35 0.35 0.35"
            specular="0 0 0"/>

        <rgba haze="0.15 0.25 0.35 1"/>

        <global
            azimuth="-130"
            elevation="-20"
            offwidth="1920"
            offheight="1080"/>
    </visual>

    <!-- Assets -->
    <asset>

        <!-- Sky -->
        <texture
            type="skybox"
            builtin="gradient"
            rgb1="0.3 0.5 0.7"
            rgb2="0 0 0"
            width="512"
            height="3072"/>

        <!-- Ground texture -->
        <texture
            type="2d"
            name="groundplane"
            builtin="checker"
            mark="edge"
            rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8"
            width="300"
            height="300"/>

        <material
            name="groundplane"
            texture="groundplane"
            texuniform="true"
            texrepeat="20 20"
            reflectance="0.2"/>

        <!-- HUGE TERRAIN -->
        <hfield
            name="huge_perlin"
            size="10 10 0.035 0.20"
            file="../huge_perlin_map_3(test).png"/>
    </asset>

    <!-- World -->
    <worldbody>

        <!-- Sun -->
        <light
            pos="0 0 5"
            dir="0 0 -1"
            directional="true"/>

        <!-- Optional flat floor underneath -->
        <geom
            name="floor"
            type="plane"
            size="0 0 0.05"
            material="groundplane"
            rgba="0.15 0.15 0.15 1"/>

        <!-- Huge terrain -->
        <geom
            type="hfield"
            hfield="huge_perlin"
            pos="0 0 0.1"
            quat="1 0 0 0"
            friction="1.0 0.05 0.01"/>

    </worldbody>

</mujoco>