<mujoco model="go2 scene">
  <include file="go2.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom pos="1.2 0 0.00" type="box"  size="0.1 2 0.02" quat="1.0 0 0 0"/>
    <geom pos="1.4 0 0.02" type="box"  size="0.1 2 0.02" quat="1.0 0 0 0"/>
    <geom pos="1.6 0 0.04" type="box"  size="0.1 2 0.02" quat="1.0 0 0 0"/>
    <geom pos="1.8 0 0.06" type="box"  size="0.1 2 0.02" quat="1.0 0 0 0"/>
    <geom pos="2.0 0 0.06" type="box"  size="0.1 2 0.02" quat="1.0 0 0 0"/>
    <geom pos="2.2 0 0.04" type="box"  size="0.1 2 0.02" quat="1.0 0 0 0"/>
    <geom pos="2.4 0 0.02" type="box"  size="0.1 2 0.02" quat="1.0 0 0 0"/>
    <geom pos="2.6 0 0.00" type="box"  size="0.1 2 0.02" quat="1.0 0 0 0"/>

    <!-- <geom pos="1.6 3.0 0.0"
      type="box"
      size="1.5 0.75 0.05"
      quat="0.9987 0 -0.0499 0"
      friction="1.5 0.1 0.1"/> -->

    <!-- Ramp going UP -->
    <geom pos="2.6 4.0 0.1"
          type="box"
          size="1.5 1.75 0.05"
          quat="0.9987 0 -0.0499 0"
          friction="1.5 0.1 0.1"/>

    <!-- Ramp going DOWN -->
    <geom pos="5.575 4.0 0.1"
          type="box"
          size="1.5 1.75 0.05"
          quat="0.9987 0 0.0499 0"
          friction="1.5 0.1 0.1"/>

    <!-- ORIGINAL START (unchanged position) -->
    <geom pos="1.2 -5 0.00" type="box" size="0.1 2 0.02"/>
    <geom pos="1.4 -5 0.02" type="box" size="0.1 2 0.02"/>
    <geom pos="1.6 -5 0.04" type="box" size="0.1 2 0.02"/>
    <geom pos="1.8 -5 0.06" type="box" size="0.1 2 0.02"/>
    <geom pos="2.0 -5 0.08" type="box" size="0.1 2 0.02"/>

    <!-- CONTINUE UP (+5 steps) -->
    <geom pos="2.2 -5 0.10" type="box" size="0.1 2 0.02"/>
    <geom pos="2.4 -5 0.12" type="box" size="0.1 2 0.02"/>
    <geom pos="2.6 -5 0.14" type="box" size="0.1 2 0.02"/>
    <geom pos="2.8 -5 0.16" type="box" size="0.1 2 0.02"/>
    <geom pos="3.0 -5 0.18" type="box" size="0.1 2 0.02"/>

    <!-- PEAK -->
    <geom pos="3.2 -5 0.18" type="box" size="0.1 2 0.02"/>

    <!-- DOWN -->
    <geom pos="3.4 -5 0.16" type="box" size="0.1 2 0.02"/>
    <geom pos="3.6 -5 0.14" type="box" size="0.1 2 0.02"/>
    <geom pos="3.8 -5 0.12" type="box" size="0.1 2 0.02"/>
    <geom pos="4.0 -5 0.10" type="box" size="0.1 2 0.02"/>
    <geom pos="4.2 -5 0.08" type="box" size="0.1 2 0.02"/>

    <!-- EXTRA DOWN (+5 steps) -->
    <geom pos="4.4 -5 0.06" type="box" size="0.1 2 0.02"/>
    <geom pos="4.6 -5 0.04" type="box" size="0.1 2 0.02"/>
    <geom pos="4.8 -5 0.02" type="box" size="0.1 2 0.02"/>
    <geom pos="5.0 -5 0.00" type="box" size="0.1 2 0.02"/>
    <geom pos="5.2 -5 0.00" type="box" size="0.1 2 0.02"/>

  </worldbody>
</mujoco>
